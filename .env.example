# Copiez en .env.local (ne jamais publier ce fichier)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret long et aléatoire (64 caractères) : openssl rand -hex 32
APP_SECRET=
# Facultatif : ancienne adresse secrète de l'admin (12+ lettres/chiffres/tirets)
ADMIN_PATH=
SUPABASE_URL=https://olhhjaoqqowiusqokkck.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_supabase_ici
# Période d'ouverture (UTC). Fermeture = 21 déc. 00:00:00 = après le 20 déc. 23:59:59
OPEN_AT=2026-11-20T00:00:00Z
CLOSE_AT=2026-12-21T00:00:00Z
# Anti-bot Cloudflare Turnstile (obligatoire en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Paiement : "sandbox" (tests internes) ou le nom de l'agrégateur retenu
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# IP des serveurs de l'agrégateur
PAYMENT_IP_WHITELIST=
# E-mails (code de connexion admin) : clé Resend et expéditeur (domaine vérifié en production)
RESEND_API_KEY=
MAIL_FROM="AÏNA <onboarding@resend.dev>"ADMIN_REQUIRE_CODE=true

# Connexion admin : true = e-mail + mot de passe + code à 6 chiffres reçu par e-mail (exige RESEND_API_KEY et un domaine vérifié).
# false = e-mail + mot de passe seulement. Si la variable est absente, le code est demandé.
# Le cahier des charges prévoit la double authentification : passer à false est une décision de la direction.
ADMIN_REQUIRE_CODE=true
